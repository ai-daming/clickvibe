{
  "name": "clickvibe",
  "version": "0.1.0",
  "packageManager": "pnpm@11.21.0",
  "description": "DSH web plugin: a right-side panel that fetches and renders GitHub issues / PRs via the local gh CLI.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "src",
    "skills",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0-rc.8",
    "@deepseek-ai/dsh-jobs": "^0.1.0-rc.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "marked": "^18.0.10",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@deepseek-ai/cordis": "^4.0.0-rc.8",
    "@deepseek-ai/dsh-jobs": "0.1.0-rc.8",
    "@deepseek-ai/dsh-jobs-local": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.8",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "lightningcss": "^1.32.0",
    "react": "^18.2.0",
    "react-dom": "18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.build.json && tsdown",
    "bundle": "tsdown",
    "test": "node --test tests/*.test.ts",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "coverage": "node --test --experimental-test-coverage --test-coverage-lines=85 --test-coverage-functions=85 tests/*.test.ts",
    "lint": "biome lint src tests scripts",
    "lint:fix": "biome lint --write src tests scripts",
    "format:check": "biome format src tests scripts",
    "fmt": "biome format --write src tests scripts",
    "check:size": "node scripts/check-file-size.mjs",
    "check:layers": "node scripts/check-import-layers.mjs",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run check:size && pnpm run check:layers"
  }
}
